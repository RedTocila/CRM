# ─── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Connect → ORM → Prisma — copy the URI, then:
#   npm run supabase:link -- --uri "postgresql://postgres.xxx:..."

# Pooler (6543) — app runtime / Vercel
DATABASE_URL="postgresql://postgres.pgcujstmvwgbrcejeksk:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Session pooler (5432) — Prisma migrations & seed
DIRECT_URL="postgresql://postgres.pgcujstmvwgbrcejeksk:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Region for pooler host (find via Supabase Connect → Prisma, or trial: eu-west-1)
SUPABASE_DB_REGION="eu-west-1"
SUPABASE_PROJECT_REF="pgcujstmvwgbrcejeksk"
NEXT_PUBLIC_SUPABASE_URL="https://pgcujstmvwgbrcejeksk.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-from-supabase-dashboard"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-from-supabase-dashboard"

# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI (optional)
OPENAI_API_KEY=""

# PayPal (optional)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_MODE="sandbox"

# Paddle (optional)
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_ENVIRONMENT="sandbox"

# Rate limiting (optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"
